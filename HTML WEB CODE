<!DOCTYPE html>
<html lang="si">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ESP32 LED Control</title>
<style>
  :root {
    --bg: #0f172a; --card: #1e293b; --text: #e2e8f0; --muted: #94a3b8;
    --off: #334155; --on: #22c55e; --glow: rgba(34,197,94,.55);
  }
  @media (prefers-color-scheme: light) {
    :root { --bg: #e2e8f0; --card: #fff; --text: #0f172a; --muted: #64748b; --off: #cbd5e1; }
  }
  * { box-sizing: border-box; }
  html, body { height: 100%; margin: 0; }
  body {
    background: var(--bg); color: var(--text);
    font-family: system-ui, sans-serif;
    display: flex; align-items: center; justify-content: center;
  }
  .card {
    background: var(--card); border-radius: 28px; padding: 36px 32px;
    width: min(92vw, 340px); text-align: center;
    box-shadow: 0 20px 50px rgba(0,0,0,.25);
  }
  h1 { font-size: 20px; margin: 0 0 4px; }
  .sub { color: var(--muted); font-size: 13px; margin-bottom: 32px; }
  .btn {
    width: 150px; height: 150px; border-radius: 50%; border: none; cursor: pointer;
    background: var(--off); color: #fff; font-size: 56px;
    transition: all .3s ease; display: inline-flex; align-items: center; justify-content: center;
  }
  .btn:active { transform: scale(.94); }
  .btn.on { background: var(--on); box-shadow: 0 0 40px 10px var(--glow); }
  .status { margin-top: 28px; font-size: 22px; font-weight: 700; letter-spacing: 1px; }
  .status.on { color: var(--on); }
  .conn { margin-top: 10px; font-size: 12px; color: var(--muted); }
  .setup { display:none; margin-top:16px; font-size:12px; color:#f59e0b; }
</style>
</head>
<body>
  <div class="card">
    <h1>💡 ESP32 LED</h1>
    <div class="sub">GPIO 23 • Firebase</div>
    <button id="btn" class="btn" aria-label="Toggle LED">⏻</button>
    <div id="status" class="status">OFF</div>
    <div id="conn" class="conn">Connecting...</div>
    <div id="setup" class="setup">DB_URL එක කොඩ් එකේ දාන්න</div>
  </div>

<script>
  // 👇 ඔබේ Firebase Database URL එක මෙතන දාන්න (අගට / නැතිව)
  const DB_URL = "https://ledblink-99ee8-default-rtdb.asia-southeast1.firebasedatabase.app";

  const btn = document.getElementById("btn");
  const statusEl = document.getElementById("status");
  const connEl = document.getElementById("conn");
  const endpoint = DB_URL + "/led/state.json";
  let state = 0;
  let busy = false;

  function render() {
    btn.classList.toggle("on", state === 1);
    statusEl.classList.toggle("on", state === 1);
    statusEl.textContent = state === 1 ? "ON" : "OFF";
  }

  async function readState() {
    if (busy) return;
    try {
      const r = await fetch(endpoint, { cache: "no-store" });
      const v = await r.json();
      state = v === 1 ? 1 : 0;
      connEl.textContent = "● Connected";
      render();
    } catch (e) {
      connEl.textContent = "Connection error";
    }
  }

  async function toggle() {
    busy = true;
    state = state === 1 ? 0 : 1;
    render();
    try {
      await fetch(endpoint, { method: "PUT", body: JSON.stringify(state) });
    } catch (e) {
      connEl.textContent = "Write error";
    }
    busy = false;
  }

  if (DB_URL.includes("YOUR-PROJECT")) {
    document.getElementById("setup").style.display = "block";
  } else {
    btn.addEventListener("click", toggle);
    readState();
    setInterval(readState, 1500);
  }
</script>
</body>
</html>
